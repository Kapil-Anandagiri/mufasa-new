{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext",
    "allowJs": true, "noEmit": true, "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "lib": [
      "dom",
      "es2015"
    ],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "src/**/*.ts",
    "src/**/*.tsx",
    "AppEntry.ts",
    "navigation/**/*.ts",
    "navigation/**/*.tsx",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "src/types/expo-router.d.ts",
    "src/types/declarations.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
